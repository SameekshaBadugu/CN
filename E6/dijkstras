#include <stdio.h>
int main(){
int a[10][10], d[10], v[10], p[10];
int n, i, j, u, min;
char s, t;
printf("\t\t Shortest Path (Dijkstra's algorithm)");
printf("\n*******************************************************************");
printf("\nEnter the number of nodes:");
scanf("%d", &n);
printf("\nEnter the adjacency matrix for the graph(-1 for no edge):\n");
for(i=0;i<n;i++)
for(j=0;j<n;j++)
scanf("%d",&a[i][j]);
printf("\nEnter the source node:");
scanf(" %c",&s);
printf("\nEnter the destination node:");
scanf(" %c",&t);
s = s-'a';
t = t-'a';
for(i=0;i<n;i++){
d[i]=9999;
v[i]=0;
p[i]=-1;
}
d[s]=0;
for(i=0;i<n;i++){
min=9999;
u=-1;
for(j=0;j<n;j++){
if(!v[j] && d[j]<min){
min=d[j];
u=j;
}
}
if(u==-1) break;
v[u]=1;
for(j=0;j<n;j++){
  if(a[u][j]!=-1 && !v[j] && d[u]+a[u][j]<d[j]){
d[j]=d[u]+a[u][j];
p[j]=u;
}
}
}
printf("\nShortest path:\n");
printf("From %c to %c is:",s+'a',t+'a');
if(d[t]==9999)
printf(" No path");
else{
int path[10], k=0;
for(i=t;i!=-1;i=p[i])
path[k++]=i;
for(i=k-1;i>=0;i--)
printf("%c ",path[i]+'a');
printf("\t length=%d\n",d[t]);
}
  return 0;
}



