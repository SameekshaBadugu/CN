#include <stdio.h>
int main(){
int n, adj[20][20], tree[20][20] = {0};
int visited[20] = {0};
int i, j, k, min, source;
printf("Enter no. of nodes: ");
scanf("%d", &n);
printf("Enter the adjacency matrix: \n");
for (i = 0; i < n; i++)
for (j = 0; j < n; j++)
scanf("%d", &adj[i][j]);
printf("Enter the source for broadcasting: ");
scanf("%d", &source);
for (i = 0; i < n; i++){
min = 999;
for (j = 0; j < n; j++){
if (adj[i][j] != 0 && adj[i][j] < min)
min = adj[i][j];
}
for (j = 0; j < n; j++){
if (adj[i][j] == min){
tree[i][j] = adj[i][j];
tree[j][i] = adj[i][j];
}
}
}
printf("Given adjacency matrix: \n");
for (i = 0; i < n; i++){
for (j = 0; j < n; j++)
printf("%d ", adj[i][j]);
printf("\n");
}
printf("Minimal Spanning Tree: \n");
for (i = 0; i < n; i++){
for (j = 0; j < n; j++)
printf("%d ", tree[i][j]);
printf("\n");
}
visited[source] = 1;
for (k = 0; k < n; k++){
for (i = 0; i < n; i++){
if (visited[i]) {
for (j = 0; j < n; j++){
if (tree[i][j] != 0 && !visited[j]){
printf("%d sends message to %d \n", i, j);
visited[j] = 1;
}
}
}
}
}
return 0;
}

